rules_version = '2';
// MiAgenda — Reglas Firestore endurecidas.
// Publicar en Firebase Console → proyecto miagenda-37996 → Firestore Database → Reglas → pegar TODO → Publicar.
// Estas reglas NO borran ni modifican datos: solo controlan quién puede leer/escribir.
// Requiere la versión de la app con el cambio "limite de integrantes tolerante" (ya publicada en main).
service cloud.firestore {
  match /databases/{database}/documents {

    function logueado() { return request.auth != null; }
    function esAnonimo() { return logueado() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function esDueno(uid) { return logueado() && !esAnonimo() && request.auth.uid == uid; }
    function esAdmin() {
      return logueado()
        && request.auth.token.email == 'rgaraventa@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function toca(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(campos);
    }
    function altaValida() {
      let d = request.resource.data;
      return (!('banned' in d) || d.banned == false)
        && (!('status' in d) || d.status == 'demo')
        && (!('isAdmin' in d) || d.isAdmin == false)
        && (!('features' in d) || d.features == {'limiteIntegrantes': 1})
        && (!('demoExpiry' in d) || d.demoExpiry == null || d.demoExpiry <= request.time + duration.value(15, 'd'));
    }
    function cupoDisponible(grupo) {
      return get(/databases/$(database)/documents/usuarios/$(grupo.ownerUid)).data.get('features', {}).get('limiteIntegrantes', 1) > grupo.miembros.size();
    }

    // Usuarios: cada uno solo el suyo. Protegidos: status, banned, demoExpiry, isAdmin, features (los cambia solo el admin).
    match /usuarios/{uid} {
      allow get: if esDueno(uid) || esAdmin();
      allow list: if esAdmin();
      allow create: if (esDueno(uid) && altaValida()) || esAdmin();
      allow update: if (esDueno(uid) && !toca(['status','banned','demoExpiry','isAdmin','features']))
        || esAdmin()
        // El dueño de un grupo, al disolverlo, libera a sus integrantes (solo grupoId -> null)
        || (logueado()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['grupoId'])
            && request.resource.data.grupoId == null
            && resource.data.grupoId is string
            && get(/databases/$(database)/documents/grupos/$(resource.data.grupoId)).data.ownerUid == request.auth.uid);
      allow delete: if esAdmin();

      match /tareas/{tareaId} {
        allow read, write: if esDueno(uid);
        allow read: if esAdmin();
      }
    }

    // Grupos: leen los logueados (para poder sumarse con el link); modifican solo dueño / integrantes
    match /grupos/{gid} {
      allow read: if logueado();
      allow create: if logueado() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.miembros == [request.auth.uid];
      allow update: if logueado() && (
        // dueño: cualquier cambio salvo cambiar de dueño
        (request.auth.uid == resource.data.ownerUid && request.resource.data.ownerUid == resource.data.ownerUid)
        // integrante que se va
        || (request.auth.uid in resource.data.miembros
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['miembros'])
            && request.resource.data.miembros.size() == resource.data.miembros.size() - 1
            && !(request.auth.uid in request.resource.data.miembros))
        // persona que se suma (con cupo disponible validado en el servidor)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['miembros'])
            && request.resource.data.miembros == resource.data.miembros.concat([request.auth.uid])
            && cupoDisponible(resource.data))
      );
      allow delete: if logueado() && resource.data.ownerUid == request.auth.uid;

      match /tareas/{tid} {
        allow read, write: if logueado()
          && request.auth.uid in get(/databases/$(database)/documents/grupos/$(gid)).data.miembros;
      }
    }

    // Invitaciones: se leen por id (link), no se listan
    match /invitacionesGrupo/{id} {
      allow get: if logueado();
      allow create: if logueado()
        && request.resource.data.creadoPorUid == request.auth.uid
        && get(/databases/$(database)/documents/grupos/$(request.resource.data.grupoId)).data.ownerUid == request.auth.uid;
      allow update: if logueado()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoUsadoPor','ultimoUsadoAt']);
      allow delete: if logueado() && resource.data.creadoPorUid == request.auth.uid;
    }

    match /errores/{id} {
      allow create: if logueado();
      allow read, delete: if esAdmin();
    }

    match /{path=**} { allow read, write: if false; }
  }
}
