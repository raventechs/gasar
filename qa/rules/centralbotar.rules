rules_version = '2';
// CentralBotAR — Reglas Firestore endurecidas. El servidor (webhook de WhatsApp) usa Admin SDK y no depende de estas reglas.
// Publicar en Firebase Console → proyecto centralbotar → Firestore Database → Reglas → pegar TODO → Publicar.
// Estas reglas NO borran ni modifican datos: solo controlan quién puede leer/escribir.
service cloud.firestore {
  match /databases/{database}/documents {

    function logueado() { return request.auth != null; }
    function esAnonimo() { return logueado() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function esDueno(uid) { return logueado() && !esAnonimo() && request.auth.uid == uid; }
    function esAdmin() {
      return logueado()
        && request.auth.token.email == 'rgaraventa@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function toca(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(campos);
    }

    // Usuario: su propio documento (negocioId y rol no se cambian solos)
    match /usuarios/{uid} {
      allow get: if esDueno(uid) || esAdmin();
      allow list: if esAdmin();
      allow create: if (esDueno(uid)
                        && request.resource.data.negocioId == uid
                        && request.resource.data.rolNegocio == 'owner')
                    || esAdmin();
      allow update: if (esDueno(uid) && !toca(['negocioId','rolNegocio'])) || esAdmin();
      allow delete: if esAdmin();
    }

    // Negocio (id = uid del dueño). Plan y consumo (features, mensajesEsteMes) solo los cambia el admin o el servidor.
    match /negocios/{nid} {
      allow get: if esDueno(nid) || esAdmin();
      allow list: if esAdmin();
      allow create: if (esDueno(nid)
                        && request.resource.data.ownerUid == request.auth.uid
                        && request.resource.data.features == {'limiteMensajesMes': 200, 'handoffNivel': 'medio'}
                        && request.resource.data.mensajesEsteMes == 0)
                    || esAdmin();
      allow update: if (esDueno(nid) && !toca(['features','mensajesEsteMes','ownerUid'])) || esAdmin();
      allow delete: if esAdmin();

      // Conversaciones y mensajes (los escribe el servidor; el dueño las lee, responde y las restaura desde backup)
      match /conversaciones/{cid}/{sub=**} {
        allow read, write: if esDueno(nid);
        allow read: if esAdmin();
      }
      match /conversaciones/{cid} {
        allow read, write: if esDueno(nid);
        allow read: if esAdmin();
      }
    }

    match /errores/{id} {
      allow create: if logueado();
      allow read, delete: if esAdmin();
    }

    match /{path=**} { allow read, write: if false; }
  }
}
