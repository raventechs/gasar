rules_version = '2';
// PeloteAR — Reglas Firestore. La app solo guarda el registro de errores en la base de datos.
// Publicar en Firebase Console → proyecto pelotear-1f37e → Firestore Database → Reglas → pegar TODO → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /errores/{id} {
      allow create: if request.auth != null;
      allow read, delete: if request.auth != null
        && request.auth.token.email == 'rgaraventa@gmail.com'
        && request.auth.token.email_verified == true;
    }
    match /{path=**} { allow read, write: if false; }
  }
}
