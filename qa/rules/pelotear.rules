rules_version = '2';
// PeloteAR — Reglas Firestore (v2: datos propios de cada dueño en Firestore).
// Publicar en Firebase Console → proyecto pelotear-1f37e → Firestore Database → Reglas → pegar TODO → Publicar.
// Estas reglas NO borran ni modifican datos: solo controlan quién puede leer/escribir.
service cloud.firestore {
  match /databases/{database}/documents {

    function logueado() { return request.auth != null; }
    function esDueno(uid) { return logueado() && request.auth.uid == uid; }
    function esAdmin() {
      return logueado()
        && request.auth.token.email == 'rgaraventa@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Registro de usuarios: cada dueño escribe solo el suyo; el fin de la prueba gratis (demoHasta)
    // solo puede fijarlo una vez (máx. 15 días). El admin lee todos y lo cambia.
    match /usuarios/{uid} {
      allow read: if esAdmin() || esDueno(uid);
      allow create: if esDueno(uid)
        && request.resource.data.keys().hasOnly(['email','nombre','alta','ultimoAcceso','app','demoHasta'])
        && (!('demoHasta' in request.resource.data) || request.resource.data.demoHasta <= request.time + duration.value(15, 'd'));
      allow update: if esAdmin()
        || (esDueno(uid)
            && request.resource.data.keys().hasOnly(['email','nombre','alta','ultimoAcceso','app','demoHasta'])
            && (request.resource.data.get('demoHasta', null) == resource.data.get('demoHasta', null)
                || (!('demoHasta' in resource.data) && request.resource.data.demoHasta <= request.time + duration.value(15, 'd'))));
      allow delete: if esAdmin();

      // Datos del complejo (config, productos, reservas, ventas, cierres, backups): solo el dueño.
      match /{sub=**} {
        allow read, write: if esDueno(uid);
      }
    }

    // Registro de errores: cualquier usuario logueado escribe, solo el admin lee
    match /errores/{id} {
      allow create: if logueado();
      allow read, delete: if esAdmin();
    }

    // Todo lo demás: cerrado
    match /{path=**} { allow read, write: if false; }
  }
}
